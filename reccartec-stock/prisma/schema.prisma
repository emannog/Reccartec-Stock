generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id        Int       @id @default(autoincrement())
  nome      String    @unique
  descricao String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  produtos  Produto[]
}

model Produto {
  id          Int            @id @default(autoincrement())
  nome        String
  descricao   String?
  codigo      Int            @unique
  preco       Float
  quantidade  Int            @default(0)
  minimo      Int            @default(0)
  categoriaId Int
  categoria   Categoria      @relation(fields: [categoriaId], references: [id])
  desconto    Float?         @default(0)
  tipoDesconto String?       @default("percentual") // percentual ou valor
  dataFimDesconto DateTime?
  ativo       Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  movimentacoes Movimentacao[]
  itensVenda  ItemVenda[]
}

model Movimentacao {
  id        Int      @id @default(autoincrement())
  tipo      String   // ENTRADA, SAIDA, AJUSTE
  quantidade Int
  produtoId Int
  produto   Produto  @relation(fields: [produtoId], references: [id])
  motivo    String?
  vendaId   Int?
  venda     Venda?   @relation(fields: [vendaId], references: [id])
  createdAt DateTime @default(now())
}

model Venda {
  id        Int        @id @default(autoincrement())
  total     Float
  totalOriginal Float?
  descontoTotal Float?
  cliente   String?
  status    String     @default("CONCLUIDA") // CONCLUIDA, CANCELADA
  createdAt DateTime   @default(now())
  itens     ItemVenda[]
  movimentacoes Movimentacao[]
}

model ItemVenda {
  id        Int      @id @default(autoincrement())
  vendaId   Int
  venda     Venda    @relation(fields: [vendaId], references: [id])
  produtoId Int
  produto   Produto  @relation(fields: [produtoId], references: [id])
  quantidade Int
  precoOriginal Float?
  precoUnitario Float
  descontoAplicado Float?
  subtotal   Float
}
